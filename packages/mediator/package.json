{
  "name": "@eventfabric/mediator",
  "description": "Mediator for EventFabric: typed Command envelope, CommandBus, middleware framework (idempotency + logging), IdempotencyStore. Backend-agnostic — pair with @eventfabric/mediator-postgres for PG-backed idempotency and @eventfabric/mediator-opentelemetry for tracing + metrics.",
  "keywords": [
    "mediator",
    "command",
    "command-bus",
    "cqrs",
    "ddd",
    "domain-driven-design",
    "idempotency",
    "middleware",
    "typescript",
    "eventfabric"
  ],
  "license": "MIT",
  "author": "Hi-Mind Limited",
  "repository": {
    "type": "git",
    "url": "https://github.com/hi-mind-ltd/eventfabric",
    "directory": "packages/mediator"
  },
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@eventfabric/core": "workspace:*"
  },
  "devDependencies": {
    "@eventfabric/core": "workspace:*",
    "@types/node": "^20.19.27",
    "vitest": "^2.1.8",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
