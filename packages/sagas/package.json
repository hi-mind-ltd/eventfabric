{
  "name": "@eventfabric/sagas",
  "description": "Saga / process manager primitive for EventFabric: typed state machines that react to events and timers, emit commands transactionally, and persist instance state. Backend-agnostic — pair with @eventfabric/sagas-postgres for PG storage and @eventfabric/sagas-opentelemetry for tracing + metrics. Sagas emit commands via @eventfabric/mediator and are dispatched through its bus.",
  "keywords": [
    "saga",
    "process-manager",
    "orchestration",
    "ddd",
    "domain-driven-design",
    "event-sourcing",
    "cqrs",
    "compensation",
    "workflow",
    "state-machine",
    "typescript",
    "eventfabric"
  ],
  "license": "MIT",
  "author": "Hi-Mind Limited",
  "repository": {
    "type": "git",
    "url": "https://github.com/hi-mind-ltd/eventfabric",
    "directory": "packages/sagas"
  },
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "vitest": "^2.1.8",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@eventfabric/core": "workspace:*",
    "@eventfabric/mediator": "workspace:*"
  }
}
